{
  "$schema": "https://schemas.tokens.studio/latest.json",
  "meta": {
    "name": "Let's Go With Francis — Design Tokens",
    "version": "1.0.0",
    "status": "V1 — substituir apenas quando ativos oficiais da marca justificarem"
  },
  "color": {
    "travel-ink": { "value": "#101417", "type": "color", "description": "Base escura — texto principal, fundos escuros, contraste máximo" },
    "warm-white": { "value": "#FAF7F1", "type": "color", "description": "Fundo principal — não usar branco puro" },
    "sand": { "value": "#D8C7AE", "type": "color", "description": "Superfícies e calor — cards, blocos secundários" },
    "heritage-gold": { "value": "#B99155", "type": "color", "description": "Assinatura premium — detalhes, linhas, ícones; nunca fundo de texto longo" },
    "ocean-teal": { "value": "#1C6B70", "type": "color", "description": "Descoberta, localização, informação de viagem" },
    "action-green": { "value": "#0B6B43", "type": "color", "description": "CTA e conversão — reservado, uso exclusivo" },
    "coral-alert": { "value": "#C35A4A", "type": "color", "description": "Avisos e urgência real" }
  },
  "typography": {
    "fontFamilies": {
      "editorial": { "value": "Fraunces, Georgia, serif", "type": "fontFamilies", "description": "Títulos editoriais" },
      "body": { "value": "'DM Sans', Arial, sans-serif", "type": "fontFamilies", "description": "Corpo, legenda visual, CTA" },
      "data": { "value": "'IBM Plex Mono', monospace", "type": "fontFamilies", "description": "Dados de rota / info compacta — uso seletivo" }
    },
    "fontWeights": {
      "editorial-regular": { "value": "400", "type": "fontWeights" },
      "editorial-medium": { "value": "500", "type": "fontWeights" },
      "editorial-semibold": { "value": "600", "type": "fontWeights" },
      "body-regular": { "value": "400", "type": "fontWeights" },
      "body-medium": { "value": "500", "type": "fontWeights" },
      "body-bold": { "value": "700", "type": "fontWeights" },
      "data-regular": { "value": "400", "type": "fontWeights" },
      "data-medium": { "value": "500", "type": "fontWeights" }
    },
    "fontSize": {
      "display": { "value": "64", "type": "fontSizes", "description": "Título de capa em formatos grandes (1080x1350+)" },
      "h1": { "value": "48", "type": "fontSizes" },
      "h2": { "value": "36", "type": "fontSizes" },
      "h3": { "value": "28", "type": "fontSizes" },
      "body-lg": { "value": "24", "type": "fontSizes" },
      "body": { "value": "20", "type": "fontSizes" },
      "caption": { "value": "18", "type": "fontSizes", "description": "Mínimo absoluto — créditos, fonte/data" },
      "cta": { "value": "22", "type": "fontSizes" }
    },
    "lineHeights": {
      "tight": { "value": "1.05", "type": "lineHeights" },
      "editorial": { "value": "1.15", "type": "lineHeights" },
      "body": { "value": "1.45", "type": "lineHeights" },
      "relaxed": { "value": "1.6", "type": "lineHeights" }
    }
  },
  "spacing": {
    "space-1": { "value": "4", "type": "spacing" },
    "space-2": { "value": "8", "type": "spacing" },
    "space-3": { "value": "12", "type": "spacing" },
    "space-4": { "value": "16", "type": "spacing" },
    "space-5": { "value": "24", "type": "spacing" },
    "space-6": { "value": "32", "type": "spacing" },
    "space-7": { "value": "48", "type": "spacing" },
    "space-8": { "value": "64", "type": "spacing" },
    "space-9": { "value": "96", "type": "spacing" },
    "safe-margin-feed": { "value": "80", "type": "spacing", "description": "Margem segura padrão para feed/carrossel 1080x1350" },
    "safe-margin-story": { "value": "120", "type": "spacing", "description": "Margem segura vertical para story/reel 1080x1920 (topo/base reservados para UI do app)" }
  },
  "borderRadius": {
    "radius-sm": { "value": "4", "type": "borderRadius" },
    "radius-md": { "value": "12", "type": "borderRadius" },
    "radius-lg": { "value": "24", "type": "borderRadius" },
    "radius-pill": { "value": "999", "type": "borderRadius" }
  },
  "boxShadow": {
    "shadow-card": {
      "value": { "x": "0", "y": "8", "blur": "24", "spread": "0", "color": "#10141733", "type": "dropShadow" },
      "type": "boxShadow",
      "description": "Elevação sutil de card — quiet luxury, nunca sombra pesada"
    },
    "shadow-overlay-scrim": {
      "value": { "x": "0", "y": "0", "blur": "0", "spread": "0", "color": "#10141799", "type": "dropShadow" },
      "type": "boxShadow",
      "description": "Uso como gradiente/scrim sobre foto para garantir contraste de texto, não como sombra literal"
    }
  },
  "opacity": {
    "scrim-light": { "value": "0.35", "type": "opacity" },
    "scrim-medium": { "value": "0.55", "type": "opacity" },
    "scrim-strong": { "value": "0.75", "type": "opacity" }
  },
  "dimension": {
    "canvas-feed-portrait": { "value": "1080x1350", "type": "other" },
    "canvas-story": { "value": "1080x1920", "type": "other" },
    "canvas-reel-cover": { "value": "1080x1920", "type": "other" },
    "canvas-carousel-cover": { "value": "1080x1350", "type": "other" }
  }
}
